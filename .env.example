# ── OpenAI API ────────────────────────────────────────────────────────────────
# Key from https://platform.openai.com/api-keys — the account also needs credit.
OPENAI_API_KEY=sk-proj-...

# Which model to use. `signal-engine verify-credentials` prints the exact ids
# your key can reach and fails loudly if this one is not among them, so you
# never discover a bad model name at 02:30 UTC.
OPENAI_MODEL=gpt-5

# Your model's published rates, used only for the cost figure in the `runs`
# tab. Left at 0 the pipeline reports tokens and no dollar amount — better than
# a confidently wrong number for a model you may have swapped.
OPENAI_INPUT_COST_PER_MTOK=0
OPENAI_OUTPUT_COST_PER_MTOK=0

# ── Google Sheets ─────────────────────────────────────────────────────────────
# The spreadsheet ID from its URL:
#   https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# Service-account credentials. Locally, point at the JSON file you downloaded.
# In GitHub Actions, set GOOGLE_SERVICE_ACCOUNT_JSON to the file's full contents
# instead (the code accepts either).
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ── Slack ─────────────────────────────────────────────────────────────────────
# Incoming webhook URL: https://api.slack.com/apps -> your app -> Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ── Apollo (optional) ─────────────────────────────────────────────────────────
# Raw API access requires Apollo's Organization plan. Leave disabled unless you
# have confirmed a working master API key. The pipeline is fully functional
# without it.
APOLLO_ENABLED=false
APOLLO_API_KEY=

# ── Sender identity (used in drafted outreach) ────────────────────────────────
# These sign the drafted emails. SENDER_EMAIL is the address you will actually
# send from — the pipeline never sends anything itself, it just writes the
# drafts so they read correctly when you paste them into that account.
SENDER_NAME=
SENDER_TITLE=
SENDER_EMAIL=
SENDER_COMPANY=Hire100x

# ── Tuning ────────────────────────────────────────────────────────────────────
# Suppress a company from the shortlist for this many days after it was posted.
DEDUPE_WINDOW_DAYS=30
# Drop funding events older than this many days.
MAX_EVENT_AGE_DAYS=14
# Drop articles published more than this many hours ago.
MAX_ARTICLE_AGE_HOURS=36
